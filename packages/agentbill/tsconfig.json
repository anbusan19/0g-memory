{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "outDir": "./dist",
    "declaration": true
  },
  "include": ["src/**/*", "scripts/**/*", "hardhat.config.ts"],
  "exclude": ["node_modules", "dist", ".next", "artifacts", "cache"]
}
